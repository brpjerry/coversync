[Unit]
Description=coversync sync agent: keeps a folder in step with a server's Library
Documentation=https://github.com/brpjerry/coversync

[Service]
# The server, the folder and where the token is come from
# ~/.config/io.github.brpjerry.coversync/sync.json, which the coversync app's
# settings page writes, or `coversync setup`.
Type=notify
ExecStart=/usr/bin/coversync run
# The network or the server being away is waited out inside. What a restart
# can't mend ends it for good: 2, nothing is set up; 3, this computer isn't
# paired with the server (any more).
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2 3
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=default.target
