+    // Chromium paces its frames with a timer that runs at 60 Hz until it is told the display's rate.
+    // Nothing else in Qt WebEngine tells it, so pages were drawn at 60 fps on faster screens.
+    if (const QScreen *qscreen = window->screen(); qscreen && m_uiCompositor) {
