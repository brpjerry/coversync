+        if (hz >= 1.0 && std::abs(hz - m_displayRefreshRate) > 0.01) {
+            m_displayRefreshRate = hz;
+            m_uiCompositor->SetDisplayVSyncParameters(base::TimeTicks::Now(), base::Hertz(hz));
+        }
+    }
