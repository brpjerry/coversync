{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "coversync",
	"version": "0.1.0",
	"identifier": "io.github.brpjerry.coversync",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": false,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
